<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/line"/><stroke android:width="1dp" android:color="@color/card"/><corners android:radius="10dp"/></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/card"/><stroke android:width="2.5dp" android:color="@color/pine"/><corners android:radius="10dp"/></shape></item>
    <item><shape><solid android:color="@color/card"/><stroke android:width="1dp" android:color="@color/card"/><corners android:radius="10dp"/></shape></item>
</selector>
