<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain SDK + WindowsDesktop framework reference, so the exe also cross-builds on Linux CI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ogen</AssemblyName>
    <RootNamespace>Ogen</RootNamespace>
    <ApplicationIcon>ogen.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>עוגן</Product>
    <AssemblyTitle>עוגן</AssemblyTitle>
    <Description>עוגן – זמן מסך יומי וחסימת רשתות</Description>
    <Company>Ogen</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <ProjectReference Include="../Ogen.Core/Ogen.Core.csproj" />
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>
  <!-- WinForms only: leave WPF out of the single-file bundle to keep the download small. -->
  <Target Name="DropWpf" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(Presentation.*|PenImc.*|wpfgfx.*|D3DCompiler.*|System\.Xaml|ReachFramework|System\.Printing|System\.Windows\.Controls\.Ribbon|System\.Windows\.Presentation|System\.Windows\.Input\.Manipulations|WindowsFormsIntegration|UIAutomation.*|DirectWriteForwarder|System\.Windows\.Forms\.Design.*|Microsoft\.DiaSymReader\.Native.*|vcruntime140_cor3|System\.Data\..*|System\.Private\.DataContractSerialization|System\.Runtime\.Serialization\..*)$'))" />
    </ItemGroup>
  </Target>
</Project>
